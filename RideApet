--==================================================
-- BLACKLIST SELECTION
-- TEXT ONLY
--==================================================

local BlacklistedEggs = {}

local EggList = {}

for EggName in pairs(EggColors) do
    table.insert(EggList, EggName)
end

table.sort(EggList)

Main:CreateDropdown({
    Name = "Blacklist Egg Text",
    Options = EggList,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "BlacklistEggText",

    Callback = function(Selected)

        BlacklistedEggs = {}

        for _, EggName in ipairs(Selected) do
            BlacklistedEggs[string.lower(EggName)] = true
        end

        if Enabled then
            RefreshESP()
        end
    end
})

--==================================================
-- EGG FUNCTIONS
--==================================================

local function GetEggColor(object)
    return EggColors[object.Name] or DefaultColor
end

local function IsEgg(object)
    return string.find(
        string.lower(object.Name),
        "egg"
    ) ~= nil
end

local function IsPlantedEgg(object)

    local ancestor = object.Parent

    while ancestor and ancestor ~= Workspace do

        if string.find(
            string.lower(ancestor.Name),
            "spawn"
        ) then
            return true
        end

        ancestor = ancestor.Parent
    end

    return false
end

local function GetEggAdornee(object)

    if object:IsA("Model") then
        return object
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Tool") then

        local handle =
            object:FindFirstChild("Handle")

        if handle then
            return handle
        end

        local model =
            object:FindFirstChildWhichIsA(
                "Model",
                true
            )

        if model then
            return model
        end

        return object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return object:FindFirstChildWhichIsA(
        "Model",
        true
    )
    or object:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

--==================================================
-- ESP HELPERS
--==================================================

local function IsDescendantOfTracked(object)

    for adornee in pairs(ESPObjects) do

        if adornee ~= object
            and object:IsDescendantOf(adornee)
        then
            return true
        end

    end

    return false
end

local function ClearDescendantsOf(object)

    for adornee, data in pairs(ESPObjects) do

        if adornee ~= object
            and adornee:IsDescendantOf(object)
        then

            if data.Highlight then
                data.Highlight:Destroy()
            end

            if data.Billboard then
                data.Billboard:Destroy()
            end

            ESPObjects[adornee] = nil
        end

    end
end

local function ClearESP()

    for adornee, data in pairs(ESPObjects) do

        if data.Highlight then
            data.Highlight:Destroy()
        end

        if data.Billboard then
            data.Billboard:Destroy()
        end

        ESPObjects[adornee] = nil
    end
end

--==================================================
-- ADD EGG ESP
--==================================================

local function AddEgg(object)

    if not Enabled then
        return
    end

    if not object:IsDescendantOf(Workspace) then
        return
    end

    if not IsEgg(object) then
        return
    end

    if IsPlantedEgg(object) then
        return
    end

    local adornee = GetEggAdornee(object)

    if not adornee then
        return
    end

    if IsDescendantOfTracked(adornee) then
        return
    end

    ClearDescendantsOf(adornee)

    if ESPObjects[adornee] then
        return
    end

    local color = GetEggColor(object)

    --==================================================
    -- HIGHLIGHT
    -- ALWAYS VISIBLE
    -- EVEN IF TEXT IS BLACKLISTED
    --==================================================

    local highlight = Instance.new("Highlight")

    highlight.Name = "EggHighlight"
    highlight.Adornee = adornee
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = color
    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.Parent = Workspace

    --==================================================
    -- TEXT
    -- HIDDEN IF BLACKLISTED
    --==================================================

    local nameLower = string.lower(object.Name)

    local IsBlacklisted =
        BlacklistedEggs[nameLower] == true

    local billboard = nil

    if not IsBlacklisted then

        billboard = Instance.new("BillboardGui")

        billboard.Name = "EggName"
        billboard.Adornee = adornee
        billboard.Size =
            UDim2.new(0, 160, 0, 50)

        billboard.StudsOffset =
            Vector3.new(0, 3.5, 0)

        billboard.AlwaysOnTop = true

        local label =
            Instance.new("TextLabel")

        label.Parent = billboard
        label.Size =
            UDim2.new(1, 0, 1, 0)

        label.BackgroundTransparency = 1

        -- ORIGINAL EGG NAME
        label.Text = object.Name

        label.TextColor3 = color
        label.TextScaled = true
        label.Font =
            Enum.Font.SourceSansBold

        local stroke =
            Instance.new("UIStroke")

        stroke.Thickness = 2
        stroke.Color =
            Color3.fromRGB(0, 0, 0)

        stroke.Parent = label

        billboard.Parent = Workspace
    end

    ESPObjects[adornee] = {
        Highlight = highlight,
        Billboard = billboard
    }
end

--==================================================
-- REFRESH ESP
--==================================================

function RefreshESP()

    ClearESP()

    if not Enabled then
        return
    end

    for _, object in pairs(
        Workspace:GetDescendants()
    ) do
        AddEgg(object)
    end
end

