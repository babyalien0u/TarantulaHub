--==================================================
-- SMOOTH TP WALK
--==================================================

local TPWalkEnabled = false
local TPWalkDistance = 50

Main:CreateSlider({
    Name = "TP Walk Distance",

    Range = {1, 150},
    Increment = 1,

    Suffix = " studs",

    CurrentValue = 50,

    Flag = "TPWalkDistance",

    Callback = function(Value)
        TPWalkDistance = Value
    end
})

Main:CreateToggle({
    Name = "TP Walk",

    CurrentValue = false,

    Flag = "TPWalk",

    Callback = function(Value)
        TPWalkEnabled = Value
    end
})

RunService.Heartbeat:Connect(
    function(deltaTime)

        if not TPWalkEnabled then
            return
        end

        local Character =
            Player.Character

        local Humanoid =
            Character
            and Character:FindFirstChildOfClass(
                "Humanoid"
            )

        local Root =
            Character
            and Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not Humanoid or not Root then
            return
        end

        local Direction =
            Humanoid.MoveDirection

        if Direction.Magnitude > 0 then

            local Movement =
                TPWalkDistance * deltaTime

            Root.CFrame =
                Root.CFrame
                + Direction * Movement
        end
    end
)

