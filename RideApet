    function()

        if not InfiniteJumpEnabled then
            return
        end

        local Character =
            Player.Character

        local Humanoid =
            Character
            and Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if Humanoid then

            Humanoid:ChangeState(
                Enum.HumanoidStateType.Jumping
            )
        end
    end
)

